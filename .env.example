# Environment Variables Example for Render & Cloud Deployment

PORT=10000
HOST=0.0.0.0
RENDER_EXTERNAL_URL=https://sim-provider-1f4c.onrender.com

# Database Connection (TiDB Cloud / MySQL)
MYSQL_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=2DQWZxtzB8QkzXZ.root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=sim_provider_data
MYSQL_SSL_CA=system

# Security & Sessions
COOKIE_SECURE=true
SESSION_HOURS=12
MAX_UPLOAD_MB=25

# Optional Custom Initial Admin (defaults to 1234 / 1234567890 if not set)
DEFAULT_ADMIN_ID=1234
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=1234567890

